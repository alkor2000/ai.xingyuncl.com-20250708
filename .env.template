# ========================================
# 星云AI平台 - 客户部署环境变量配置模板
# 使用说明：新部署复制此文件为.env，再填写本部署的配置。
# 已有部署保留原.env及密钥，只补充本次需要的Identity配置。
# ========================================

# === 数据库配置 ===
# 强随机密码，每个客户必须不同
# 生成命令: openssl rand -base64 32
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=
DB_NAME=ai_platform
DB_USER=ai_user

# === JWT密钥配置 ===
# 每个客户必须使用唯一密钥，否则token可互相使用
# 生成命令: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# === 客户域名配置 ===
# 替换为客户实际域名（不含http://或https://）
CUSTOMER_DOMAIN=
APP_DOMAIN=
CORS_ORIGINS=https://

# === Identity统一身份接入 ===
# 默认关闭；完成当前部署的客户端登记、回调校验及配置检查后才能启用。
# 这些配置只传给后端容器，不能写入前端变量或镜像构建参数。
IDENTITY_ENABLED=false
IDENTITY_ISSUER=https://id.pkuailab.com

# 当前部署的公开HTTPS来源，不带路径或末尾斜杠。
# 星云站点使用 https://ai.xingyuncl.com；
# 北大站点使用 https://ai.pkuailab.com。
# 启用接入时明确填写，不能把测试站点的地址原样复制给另一部署。
IDENTITY_PUBLIC_ORIGIN=

# 填写Identity为当前部署登记的Client ID。
# 已有环境变量接入方式继续有效，不要求重新Enrollment或轮换Secret。
# 文件接入方式必须同时明确issuer、公开来源、Client ID及部署实例标识。
IDENTITY_CLIENT_ID=
IDENTITY_DEPLOYMENT_INSTANCE_KEY=
IDENTITY_TOKEN_AUTH_METHOD=client_secret_post

# 两种Secret来源互斥：旧部署使用环境变量；Enrollment部署使用私有凭据文件。
# 文件模式必须清空IDENTITY_CLIENT_SECRET，任何文件错误都不会回退使用旧Secret。
IDENTITY_CLIENT_SECRET=
IDENTITY_CREDENTIALS_FILE=

# Docker文件模式由docker-compose.identity-runtime.yml附加配置提供只读挂载。
# IDENTITY_RUNTIME_DIR是宿主机已准备好的私有运行目录，必须位于项目/镜像上下文之外。
# 目录仅存放配套request.json与credentials.json；不得挂载其他部署或管理备份的父目录。
# 当前Docker后端以UID/GID 1001运行：目录0700、文件0400或0600，均归该运行身份所有。
# 须由受控交付流程准备独立运行副本，保留root消费者原始状态以便核实与恢复。
# 容器内凭据路径固定为/run/ai-platform-identity/credentials.json，不使用宿主机路径。
# PM2部署不使用此Docker目录变量，IDENTITY_CREDENTIALS_FILE填写其可读取的私有绝对路径。
IDENTITY_RUNTIME_DIR=

# 留空时，后端从IDENTITY_PUBLIC_ORIGIN推导下列固定回调路径：
# 登录：/api/auth/identity/login/callback
# 绑定及解绑：/api/auth/identity/callback
# 已有部署的显式回调配置继续有效，但必须与当前公开来源及对应路径一致。
IDENTITY_LOGIN_REDIRECT_URI=
IDENTITY_BIND_REDIRECT_URI=

# 留空时，从IDENTITY_ISSUER推导 /backchannel/platform-account-links。
# 不允许配置为其他来源，防止客户端凭据发送到错误服务。
IDENTITY_BACKCHANNEL_URL=

# 协议状态有效期与请求超时；单位及允许范围如下。
# Flow：秒，60–900；Handoff：秒，30–300。
# HTTP超时：毫秒，1000–30000；JWKS缓存：秒，30–3600。
IDENTITY_FLOW_TTL_SECONDS=600
IDENTITY_HANDOFF_TTL_SECONDS=90
IDENTITY_HTTP_TIMEOUT_MS=10000
IDENTITY_JWKS_CACHE_SECONDS=300

# === SSL证书路径（通常不需要修改） ===
SSL_CERT_PATH=/etc/letsencrypt

# ========================================
# 新部署生成密钥的命令（已有部署不得据此替换原密钥）：
#
# MYSQL_ROOT_PASSWORD=$(openssl rand -base64 32)
# DB_PASSWORD=$(openssl rand -base64 32)
# JWT_ACCESS_SECRET=$(node -e "console.log(require('crypto').randomBytes(64).toString('base64'))")
# JWT_REFRESH_SECRET=$(node -e "console.log(require('crypto').randomBytes(64).toString('base64'))")
#
# 然后填写域名：
# CUSTOMER_DOMAIN=你的域名.com
# APP_DOMAIN=你的域名.com
# CORS_ORIGINS=https://你的域名.com
#
# Identity启用前，还需填写本部署的公开来源及已登记客户端凭据。
# 此模板不执行Enrollment，也不会自动验证或启用Identity侧实例。
# Docker启动入口仍包含既有数据库迁移；发布前必须完成数据库备份与迁移风险核验。
# ========================================
